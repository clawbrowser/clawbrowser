+scoped_refptr<StaticBitmapImage> ImageDataBuffer::ProtectCanvasSnapshot(
+    scoped_refptr<StaticBitmapImage> image) {
+  const auto* fp = clawbrowser::FingerprintAccessor::Get();
+  if (!image || !fp || !fp->canvas_spoofing_enabled ||
+      fp->surface_policy.canvas != "override") {
+    return image;
+  }
+  auto buffer = CreateForCanvas(image);
+  if (!buffer)
+    return nullptr;
+  auto protected_image = UnacceleratedStaticBitmapImage::Create(
+      buffer->retained_image_, image->Orientation());
+  if (!protected_image)
+    return nullptr;
+  // A protected copy is not permission to read an origin-tainted canvas.
+  protected_image->SetOriginClean(image->OriginClean());
+  return protected_image;
+}
