+// Exact unorm8 source-over for bitmap blitters, matching the NEON path.
+#ifndef SkClawbrowserSrcOver_DEFINED
+#define SkClawbrowserSrcOver_DEFINED
+#include <algorithm>
+#include <cstdint>
+#if defined(__SSE2__) || defined(_M_X64)
+#include <immintrin.h>
+#define SK_CLAWBROWSER_HAS_SRCOVER4 1
+#endif
+namespace skia_private {
+inline uint32_t ClawbrowserSrcOver(uint32_t src, uint32_t dst) {
+    const unsigned inverse_alpha = 255 - (src >> 24);
+    uint32_t result = 0;
+    for (unsigned shift = 0; shift < 32; shift += 8) {
+        const unsigned product = ((dst >> shift) & 255) * inverse_alpha;
+        const unsigned rounded = (product + 127) / 255;
+        result |= std::min(255u, ((src >> shift) & 255) + rounded) << shift;
+    }
+    return result;
+}
+#if defined(SK_CLAWBROWSER_HAS_SRCOVER4)
+inline __m128i ClawbrowserSrcOver4(__m128i src, __m128i dst) {
+    __m128i scale = _mm_sub_epi32(_mm_set1_epi32(255), _mm_srli_epi32(src, 24));
+    scale = _mm_or_si128(scale, _mm_slli_epi32(scale, 16));
+    auto divide255 = [](__m128i product) {
+        // product <= 65025; both additions fit unsigned 16-bit lanes.
+        const __m128i t = _mm_add_epi16(product, _mm_set1_epi16(128));
+        return _mm_srli_epi16(_mm_add_epi16(t, _mm_srli_epi16(t, 8)), 8);
+    };
+    const __m128i rb = divide255(_mm_mullo_epi16(
+        _mm_and_si128(dst, _mm_set1_epi32(0x00ff00ff)), scale));
+    const __m128i ga = divide255(_mm_mullo_epi16(_mm_srli_epi16(dst, 8), scale));
+    return _mm_adds_epu8(src, _mm_or_si128(rb, _mm_slli_epi16(ga, 8)));
+}
+#endif
+#if defined(__AVX2__)
+inline __m256i ClawbrowserSrcOver8(__m256i src, __m256i dst) {
+    __m256i scale = _mm256_sub_epi32(_mm256_set1_epi32(255), _mm256_srli_epi32(src, 24));
+    scale = _mm256_or_si256(scale, _mm256_slli_epi32(scale, 16));
+    auto divide255 = [](__m256i product) {
+        const __m256i t = _mm256_add_epi16(product, _mm256_set1_epi16(128));
+        return _mm256_srli_epi16(_mm256_add_epi16(t, _mm256_srli_epi16(t, 8)), 8);
+    };
+    const __m256i rb = divide255(_mm256_mullo_epi16(
+        _mm256_and_si256(dst, _mm256_set1_epi32(0x00ff00ff)), scale));
+    const __m256i ga = divide255(_mm256_mullo_epi16(_mm256_srli_epi16(dst, 8), scale));
+    return _mm256_adds_epu8(src, _mm256_or_si256(rb, _mm256_slli_epi16(ga, 8)));
+}
+#endif
+}  // namespace skia_private
+#endif
