+bool IsFingerprintFontAllowed(const clawbrowser::RuntimeFingerprint& fp,
+                              const std::string& postscript_name,
+                              const std::string& full_name,
+                              const std::string& family) {
+  if (fp.fonts.empty()) {
+    return true;
+  }
+
+  for (const auto& allowed_font : fp.fonts) {
+    if (allowed_font == postscript_name || allowed_font == full_name ||
+        allowed_font == family) {
+      return true;
+    }
+  }
+
+  return false;
+}
