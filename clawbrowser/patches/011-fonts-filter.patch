+// Enumeration is only half of the surface: CSS font matching can probe the same
+// fonts by measuring text. Both paths share one allowlist, defined in
+// clawbrowser/fingerprint_coherence.h, so they cannot disagree about which
+// fonts this profile claims to have installed.
+bool IsFingerprintFontAllowed(const clawbrowser::RuntimeFingerprint& fp,
+                              const std::string& postscript_name,
+                              const std::string& full_name,
+                              const std::string& family) {
+  return clawbrowser::IsLocalFontAllowed(fp, postscript_name) ||
+         clawbrowser::IsLocalFontAllowed(fp, full_name) ||
+         clawbrowser::IsLocalFontAllowed(fp, family);
 }
 
