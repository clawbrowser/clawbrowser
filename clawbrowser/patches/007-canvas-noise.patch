+bool ImageDataBuffer::ApplyCanvasFingerprintNoise() {
+  const auto* fp = clawbrowser::FingerprintAccessor::Get();
+  if (!fp || !fp->canvas_spoofing_enabled ||
+      fp->surface_policy.canvas != "override") {
+    return true;
+  }
+
+  SkColorType copy_color_type = pixmap_.colorType();
+  auto format = CanvasNoiseFormatFor(copy_color_type);
+  if (!format) {
+    // Do not silently export an unprotected uncommon Skia format.
+    copy_color_type = kRGBA_8888_SkColorType;
+    format = clawbrowser::CanvasPixelFormat::kRgba8;
+  }
+  const SkImageInfo copy_info = SkImageInfo::Make(
+      pixmap_.width(), pixmap_.height(), copy_color_type,
+      kUnpremul_SkAlphaType, pixmap_.info().refColorSpace());
+  const size_t row_bytes = copy_info.minRowBytes();
+  const size_t byte_length = copy_info.computeByteSize(row_bytes);
+  if (SkImageInfo::ByteSizeOverflowed(byte_length))
+    return false;
+
+  sk_sp<SkData> data = SkData::MakeUninitialized(byte_length);
+  if (!pixmap_.readPixels(copy_info, data->writable_data(), row_bytes, 0, 0))
+    return false;
+
+  const bool applied = clawbrowser::ApplyDeterministicCanvasNoise(
+      static_cast<uint8_t*>(data->writable_data()), byte_length, row_bytes,
+      copy_info.width(), copy_info.height(), *format, fp->canvas_seed);
+  if (!applied)
+    return false;
+
+  retained_image_ =
+      SkImages::RasterFromData(copy_info, std::move(data), row_bytes);
+  if (!retained_image_ || !retained_image_->peekPixels(&pixmap_))
+    return false;
+  MSAN_CHECK_MEM_IS_INITIALIZED(pixmap_.addr(), pixmap_.computeByteSize());
+  return true;
+}
