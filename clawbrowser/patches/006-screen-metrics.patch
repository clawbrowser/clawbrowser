 double LocalDOMWindow::devicePixelRatio() const {
+  // Guarded on > 0 so a fingerprint missing this field cannot report a device
+  // pixel ratio of 0 here while CSS `resolution` falls back to the real value
+  // (media_values.cc) -- the two must agree or they become a tell in
+  // themselves.
+  if (const auto* fp = clawbrowser::FingerprintAccessor::Get();
+      fp && fp->screen.pixel_ratio > 0.0) {
+    return fp->screen.pixel_ratio;
+  }
   if (!GetFrame()) {
     return 0.0;
   }
