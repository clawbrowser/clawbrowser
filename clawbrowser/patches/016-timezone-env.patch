+void MaybeSetClawbrowserTimeZoneFromCommandLine() {
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  if (!command_line ||
+      !command_line->HasSwitch("clawbrowser-fp-child-data")) {
+    return;
+  }
 
+  std::string json;
+  if (!base::Base64Decode(
+          command_line->GetSwitchValueASCII("clawbrowser-fp-child-data"),
+          &json)) {
+    return;
+  }
+
+  std::optional<base::Value> parsed =
+      base::JSONReader::Read(json, base::JSON_PARSE_RFC);
+  if (!parsed || !parsed->is_dict()) {
+    return;
+  }
+
+  const std::string* timezone = parsed->GetDict().FindString("timezone");
+  if (!timezone || timezone->empty()) {
+    return;
+  }
+#if BUILDFLAG(IS_WIN)
+  _putenv_s("TZ", timezone->c_str());
+  _tzset();
+#else
+  setenv("TZ", timezone->c_str(), 1);
+  tzset();
+#endif
+}
