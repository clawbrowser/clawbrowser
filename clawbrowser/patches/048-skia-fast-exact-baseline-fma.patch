+// Correctly rounded binary32 FMA for baseline software raster paths.
+#ifndef SkClawbrowserFma_DEFINED
+#define SkClawbrowserFma_DEFINED
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <limits>
+#if defined(__SSE2__) || defined(_M_X64) || (defined(_M_IX86_FP) && _M_IX86_FP >= 2)
+#include <emmintrin.h>
+#define SK_CLAWBROWSER_HAS_SSE2_FMA4 1
+#endif
+
+namespace skia_private {
+inline float ClawbrowserFma(float f, float m, float a) {
+    // Skia uses round-to-nearest. The binary32 product is exact in binary64.
+    const double product = static_cast<double>(f) * m;
+    const double addend = a;
+    const double sum = product + addend;
+    const double magnitude = std::abs(sum);
+    // Binary32 inputs cannot underflow a binary64 sum to zero. Thus this
+    // preserves the exact zero and its sign, without a library call.
+    if (sum == 0.0) {
+        return static_cast<float>(sum);
+    }
+    uint64_t bits;
+    static_assert(sizeof(bits) == sizeof(sum));
+    static_assert(std::numeric_limits<float>::is_iec559 &&
+                  std::numeric_limits<double>::is_iec559 &&
+                  std::numeric_limits<float>::digits == 24 &&
+                  std::numeric_limits<double>::digits == 53);
+    std::memcpy(&bits, &sum, sizeof(bits));
+    if (magnitude >= std::numeric_limits<float>::min() &&
+        magnitude <= std::numeric_limits<float>::max()) {
+        if ((bits & 0x1fffffffULL) == 0x10000000ULL) {
+            // Double rounding is ambiguous only at a binary32 midpoint.
+            // TwoSum recovers the exact binary64 addition residual.
+            const double recovered_addend = sum - product;
+            const double error = (product - (sum - recovered_addend)) +
+                                 (addend - recovered_addend);
+            if (error != 0.0) {
+                // Move one binary64 ULP toward the exact sum, breaking the
+                // binary32 midpoint tie in the correct direction.
+                bits += ((error > 0.0) == (sum > 0.0)) ? 1 : uint64_t(-1);
+                double adjusted;
+                std::memcpy(&adjusted, &bits, sizeof(adjusted));
+                return static_cast<float>(adjusted);
+            }
+        }
+        return static_cast<float>(sum);
+    }
+    // Keep library semantics for subnormals, overflow and non-finite values.
+    return std::fma(f, m, a);
+}
+
+#if defined(SK_CLAWBROWSER_HAS_SSE2_FMA4)
+#if defined(_MSC_VER)
+#define SK_CLAWBROWSER_FMA_INLINE __forceinline
+#define SK_CLAWBROWSER_FMA_COLD inline __declspec(noinline)
+#else
+#define SK_CLAWBROWSER_FMA_INLINE inline __attribute__((always_inline))
+#define SK_CLAWBROWSER_FMA_COLD inline __attribute__((noinline))
+#endif
+inline int ClawbrowserFmaResidualMask(__m128d product, __m128d addend, __m128d sum) {
+    const __m128d zero = _mm_setzero_pd();
+    const __m128d recovered = _mm_sub_pd(sum, product);
+    const __m128d error = _mm_add_pd(
+        _mm_sub_pd(product, _mm_sub_pd(sum, recovered)),
+        _mm_sub_pd(addend, recovered));
+    return _mm_movemask_pd(_mm_cmpneq_pd(error, zero));
+}
+
+// Keep exceptional lane repair outside the hot path so ordinary stages do
+// not reserve its stack frame or spill all pixel registers around a call.
+SK_CLAWBROWSER_FMA_COLD __m128 ClawbrowserFma4Slow(
+        __m128 f, __m128 m, __m128 a, __m128 result, int mask) {
+    alignas(16) float fs[4], ms[4], as[4], values[4];
+    _mm_store_ps(fs, f);
+    _mm_store_ps(ms, m);
+    _mm_store_ps(as, a);
+    _mm_store_ps(values, result);
+    for (int i = 0; i < 4; ++i) {
+        if (mask & (1 << i)) {
+            values[i] = ClawbrowserFma(fs[i], ms[i], as[i]);
+        }
+    }
+    return _mm_load_ps(values);
+}
+
+SK_CLAWBROWSER_FMA_INLINE __m128 ClawbrowserFma4(__m128 f, __m128 m, __m128 a) {
+    // Keep the normal calculation vectorized: two double lanes per SSE2 op.
+    const __m128d product_lo = _mm_mul_pd(_mm_cvtps_pd(f), _mm_cvtps_pd(m));
+    const __m128d product_hi = _mm_mul_pd(
+        _mm_cvtps_pd(_mm_movehl_ps(f, f)), _mm_cvtps_pd(_mm_movehl_ps(m, m)));
+    const __m128d addend_lo = _mm_cvtps_pd(a);
+    const __m128d addend_hi = _mm_cvtps_pd(_mm_movehl_ps(a, a));
+    const __m128d sum_lo = _mm_add_pd(product_lo, addend_lo);
+    const __m128d sum_hi = _mm_add_pd(product_hi, addend_hi);
+    const __m128 result = _mm_movelh_ps(_mm_cvtpd_ps(sum_lo), _mm_cvtpd_ps(sum_hi));
+    // Pack the four binary64 words once; classify all four lanes with SSE2.
+    const __m128i low = _mm_castps_si128(_mm_shuffle_ps(
+        _mm_castpd_ps(sum_lo), _mm_castpd_ps(sum_hi), _MM_SHUFFLE(2, 0, 2, 0)));
+    const __m128i high = _mm_and_si128(_mm_castps_si128(_mm_shuffle_ps(
+        _mm_castpd_ps(sum_lo), _mm_castpd_ps(sum_hi), _MM_SHUFFLE(3, 1, 3, 1))),
+        _mm_set1_epi32(0x7fffffff));
+    // [2^-126, 2^128): includes the float overflow midpoint, whose residual
+    // must still be checked. Subnormal and non-finite sums take the slow path.
+    const __m128i normal = _mm_and_si128(
+        _mm_cmpgt_epi32(high, _mm_set1_epi32(0x380fffff)),
+        _mm_cmpgt_epi32(_mm_set1_epi32(0x47f00000), high));
+    const __m128i zero = _mm_cmpeq_epi32(_mm_or_si128(high, low), _mm_setzero_si128());
+    const int valid = _mm_movemask_ps(_mm_castsi128_ps(_mm_or_si128(normal, zero)));
+    const int midpoint = valid & _mm_movemask_ps(_mm_castsi128_ps(_mm_cmpeq_epi32(
+        _mm_and_si128(low, _mm_set1_epi32(0x1fffffff)), _mm_set1_epi32(0x10000000))));
+    int mask = (~valid) & 15;
+    if (midpoint) {
+        mask |= midpoint & (ClawbrowserFmaResidualMask(product_lo, addend_lo, sum_lo) |
+                            (ClawbrowserFmaResidualMask(product_hi, addend_hi, sum_hi) << 2));
+    }
+    if (!mask) {
+        return result;
+    }
+    return ClawbrowserFma4Slow(f, m, a, result, mask);
+}
+#undef SK_CLAWBROWSER_FMA_INLINE
+#undef SK_CLAWBROWSER_FMA_COLD
+#endif
+}  // namespace skia_private
+#endif
