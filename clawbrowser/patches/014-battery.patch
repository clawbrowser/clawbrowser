 bool BatteryManager::charging() {
+  if (const auto* fp = clawbrowser::FingerprintAccessor::Get();
+      fp && fp->battery && fp->battery->charging.has_value()) {
+    return *fp->battery->charging;
+  }
   return battery_status_.Charging();
 }
 
 double BatteryManager::chargingTime() {
+  // Spoofing charging/level while this keeps reporting the host battery
+  // produces impossible states -- a "charging" battery that still reports a
+  // finite time until empty, for instance. Resolve both times from the same
+  // spoofed inputs so the four BatteryManager values cannot contradict.
+  if (const auto* fp = clawbrowser::FingerprintAccessor::Get();
+      fp && fp->battery) {
+    return clawbrowser::ResolveBatteryTimes(
+               *fp->battery, static_cast<uint64_t>(fp->canvas_seed))
+        .charging_time;
+  }
   return battery_status_.charging_time().InSecondsF();
 }
 
 double BatteryManager::dischargingTime() {
+  if (const auto* fp = clawbrowser::FingerprintAccessor::Get();
+      fp && fp->battery) {
+    return clawbrowser::ResolveBatteryTimes(
+               *fp->battery, static_cast<uint64_t>(fp->canvas_seed))
+        .discharging_time;
+  }
   return battery_status_.discharging_time().InSecondsF();
 }
 
 double BatteryManager::level() {
+  if (const auto* fp = clawbrowser::FingerprintAccessor::Get();
+      fp && fp->battery && fp->battery->level.has_value()) {
+    return *fp->battery->level;
+  }
   return battery_status_.Level();
 }
 
