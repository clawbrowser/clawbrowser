diff --git a/chrome/installer/util/initial_preferences_unittest.cc b/chrome/installer/util/initial_preferences_unittest.cc
index 00e07f4b4847..402f81ea1fd3 100644
--- a/chrome/installer/util/initial_preferences_unittest.cc
+++ b/chrome/installer/util/initial_preferences_unittest.cc
@@ -387,5 +387,22 @@ TEST_F(InitialPreferencesTest, GetInstallPreferencesTest) {
   EXPECT_FALSE(
       prefs2.GetBool(installer::initial_preferences::kSystemLevel, &value));
   EXPECT_FALSE(
       prefs2.GetBool(installer::initial_preferences::kVerboseLogging, &value));
+
+  // Clawbrowser agent installs suppress all post-install browser launch paths.
+  cmd_str = L"setup.exe --clawbrowser-agent-install";
+  cmd_line.ParseFromString(cmd_str);
+  installer::InitialPreferences prefs3(cmd_line);
+  ExpectedBooleans expected_bool3[] = {
+      {installer::initial_preferences::kDoNotLaunchChrome, true},
+      {installer::initial_preferences::kDoNotRegisterForUpdateLaunch, true},
+  };
+
+  for (const auto& expected : expected_bool3) {
+    EXPECT_TRUE(prefs3.GetBool(expected.name, &value));
+    EXPECT_EQ(value, expected.expected_value) << expected.name;
+  }
+
+  EXPECT_FALSE(
+      prefs3.GetBool(installer::initial_preferences::kSystemLevel, &value));
 }
