+
+const FontPlatformData* CatalogPlatformData(const FontDescription& d,
+                                          sk_sp<SkTypeface> typeface,
+                                          float size) {
+  if (!typeface)
+    return nullptr;
+  const bool bold = d.SyntheticBoldAllowed() &&
+      (d.IsSyntheticBold() ||
+       (d.Weight() > FontSelectionValue(500) && !typeface->isBold()));
+  const bool italic = d.SyntheticItalicAllowed() &&
+      (d.IsSyntheticItalic() || (d.Style() && !typeface->isItalic()));
+  int collection_index = 0;
+  auto stream = typeface->openStream(&collection_index);
+  CHECK(stream);
+  return FontCustomPlatformData::Create(std::move(typeface), 0)
+      ->GetFontPlatformData(
+          size, d.AdjustedSpecifiedSize(), bold, italic,
+          d.GetFontSelectionRequest(), FontSelectionCapabilities(),
+          d.FontOpticalSizing(), d.TextRendering(), d.ResolveFontFeatures(),
+          d.Orientation(), d.VariationSettings(), d.GetFontPalette(),
+          collection_index);
+}

