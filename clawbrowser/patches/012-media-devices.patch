+mojom::blink::MediaDeviceType DeviceTypeFromFingerprint(
+    const clawbrowser::RuntimeMediaDevice& device) {
+  const std::string kind = device.kind.value_or("audioinput");
+  if (kind == "videoinput") {
+    return mojom::blink::MediaDeviceType::kMediaVideoInput;
+  }
+  if (kind == "audiooutput") {
+    return mojom::blink::MediaDeviceType::kMediaAudioOutput;
+  }
+  return mojom::blink::MediaDeviceType::kMediaAudioInput;
+}
+
+MediaDeviceInfoVector BuildSpoofedMediaDevices(
+    const clawbrowser::RuntimeFingerprint& fp) {
+  MediaDeviceInfoVector devices;
+  devices.ReserveInitialCapacity(fp.media_devices.size());
+  for (const auto& device : fp.media_devices) {
+    devices.push_back(MakeGarbageCollected<MediaDeviceInfo>(
+        String::FromUtf8(device.device_id.value_or(std::string())),
+        String::FromUtf8(device.label.value_or(std::string())), String(),
+        DeviceTypeFromFingerprint(device)));
+  }
+  return devices;
+}
