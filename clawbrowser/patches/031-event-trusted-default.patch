#
# Make DOM events report Event.isTrusted === true by default.
#
# In stock Blink, every Event starts out with is_trusted_ == false and only
# events synthesized by the user agent flip the flag to true via SetTrusted().
# As a result script-created events (new Event(), new MouseEvent(),
# document.createEvent()+initEvent(), element.dispatchEvent(), as well as the
# events injected through CDP Input.dispatch* in some paths) are observable as
# untrusted and are a trivial automation tell.
#
# ClawBrowser flips the default so that the trusted bit is set on construction
# and is no longer cleared by the legacy initEvent() initializer. User-agent
# events already call SetTrusted(true) and are unaffected.
--- a/third_party/blink/renderer/core/dom/events/event.cc
+++ b/third_party/blink/renderer/core/dom/events/event.cc
@@ -87,7 +87,9 @@ Event::Event(const AtomicString& event_type,
       default_prevented_(false),
       default_handled_(false),
       was_initialized_(true),
-      is_trusted_(false),
+      // ClawBrowser: scripted events are reported as user-generated so that
+      // automation is indistinguishable from genuine user input.
+      is_trusted_(true),
       prevent_default_called_on_uncancelable_event_(false),
       legacy_did_listeners_throw_flag_(false),
       fire_only_capture_listeners_at_target_(false),
@@ -127,7 +127,9 @@ void Event::initEvent(const AtomicString& event_type_arg,
   was_initialized_ = true;
   propagation_stopped_ = false;
   immediate_propagation_stopped_ = false;
   default_prevented_ = false;
-  is_trusted_ = false;
+  // ClawBrowser: keep the trusted bit set on the legacy
+  // createEvent()+initEvent() path as well.
+  is_trusted_ = true;
   prevent_default_called_on_uncancelable_event_ = false;

   type_ = event_type_arg;
