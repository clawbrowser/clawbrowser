+HeapVector<Member<SpeechSynthesisVoice>> BuildSpoofedVoiceList(
+    const clawbrowser::RuntimeFingerprint& fp) {
+  HeapVector<Member<SpeechSynthesisVoice>> voices;
+  voices.ReserveInitialCapacity(fp.speech_voices.size());
+
+  const String language =
+      fp.language.empty() ? String() : String::FromUtf8(fp.language.front());
+  bool is_default = true;
+  for (const auto& voice_name : fp.speech_voices) {
+    auto voice = mojom::blink::SpeechSynthesisVoice::New();
+    voice->voice_uri = String::FromUtf8(voice_name);
+    voice->name = String::FromUtf8(voice_name);
+    voice->lang = language;
+    voice->is_local_service = true;
+    voice->is_default = is_default;
+    voices.push_back(
+        MakeGarbageCollected<SpeechSynthesisVoice>(std::move(voice)));
+    is_default = false;
+  }
+
+  return voices;
+}
+
