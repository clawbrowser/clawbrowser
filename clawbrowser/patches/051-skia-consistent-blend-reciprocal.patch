--- a/third_party/skia/src/opts/SkRasterPipeline_opts.h
+++ b/third_party/skia/src/opts/SkRasterPipeline_opts.h
@@ -1520,12 +1520,16 @@
 }
 
+// Blend math must not depend on each CPU's reciprocal estimate precision.
+// Use vector division, as softlight already does, rather than approximate
+// reciprocal instructions or a target-dependent number of Newton steps.
+// Keep rsqrt's existing policy separate from this change.
+SI F rcp_fast(F v) { return (F() + 1.0f) / v; }
+
 #if defined(SKRP_CPU_SCALAR) || defined(SKRP_CPU_SSE2)
     // In scalar and SSE2 mode, we always use precise math so we can have more predictable results.
     // Chrome will use the SSE2 implementation when --disable-skia-runtime-opts is set. (b/40042946)
-    SI F rcp_fast(F v) { return rcp_precise(v); }
     SI F rsqrt(F v)    { return rcp_precise(sqrt_(v)); }
 #else
-    SI F rcp_fast(F v) { return rcp_approx(v); }
     SI F rsqrt(F v)    { return rsqrt_approx(v); }
 #endif
 
