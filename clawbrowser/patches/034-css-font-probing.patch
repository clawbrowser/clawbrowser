+  // Local font probing defense.
+  //
+  // Filtering queryLocalFonts() only closes the enumeration API. CSS font
+  // matching still resolves any family installed on the host, so a page can
+  // detect fonts without any permission prompt by rendering text in a
+  // candidate family and measuring it against a fallback -- the classic
+  // width-comparison probe, which also reaches through canvas measureText()
+  // and document.fonts.check().
+  //
+  // Refusing to resolve non-allowlisted local families makes every such probe
+  // fall through to the next family in the stack, so unavailable fonts all
+  // measure identically instead of revealing themselves. Web fonts are matched
+  // above and are unaffected; generic families must keep resolving or there is
+  // no fallback left to render with.
+  if (!font_family.FamilyIsGeneric() &&
+      clawbrowser::IsLocalFontBlocked(family_name.Utf8())) {
+    return nullptr;
+  }
