+struct ClawbrowserSetupWizardState {
+  ClawbrowserSetupWizardState(const Configuration& config,
+                              const wchar_t* archive,
+                              const wchar_t* setup,
+                              bool compressed)
+      : configuration(config),
+        archive_path(archive),
+        setup_path(setup),
+        compressed_archive(compressed),
+        result(GENERIC_ERROR) {}
+
+  const Configuration& configuration;
+  const wchar_t* archive_path;
+  const wchar_t* setup_path;
+  bool compressed_archive;
+  ProcessExitResult result;
+  HWND window = nullptr;
+  HWND status_text = nullptr;
+  HWND install_button = nullptr;
+  HWND cancel_button = nullptr;
+  HANDLE install_thread = nullptr;
+  bool started = false;
+  bool finished = false;
+};
+
+DWORD WINAPI ClawbrowserSetupInstallThread(void* param) {
+  ClawbrowserSetupWizardState* state =
+      reinterpret_cast<ClawbrowserSetupWizardState*>(param);
+  state->result =
+      RunSetup(state->configuration, state->archive_path, state->setup_path,
+               state->compressed_archive, true);
+  ::PostMessage(state->window, kClawbrowserInstallCompleteMessage, 0, 0);
+  return 0;
+}
+
+void StartClawbrowserSetupInstall(ClawbrowserSetupWizardState* state) {
+  state->started = true;
+  ::SetWindowText(state->status_text,
+                  L"Installing Clawbrowser. This can take a minute...");
+  ::SetWindowText(state->install_button, L"Installing...");
+  ::EnableWindow(state->install_button, FALSE);
+  ::EnableWindow(state->cancel_button, FALSE);
+
+  state->install_thread =
+      ::CreateThread(nullptr, 0, ClawbrowserSetupInstallThread, state, 0,
+                     nullptr);
+  if (!state->install_thread) {
+    state->result = ProcessExitResult(RUN_SETUP_FAILED_COULD_NOT_CREATE_PROCESS,
+                                      ::GetLastError());
+    ::PostMessage(state->window, kClawbrowserInstallCompleteMessage, 0, 0);
+  }
+}
+
+void FinishClawbrowserSetupInstall(ClawbrowserSetupWizardState* state) {
+  state->finished = true;
+  if (state->install_thread) {
+    ::CloseHandle(state->install_thread);
+    state->install_thread = nullptr;
+  }
+
+  if (state->result.IsSuccess()) {
+    ::SetWindowText(state->status_text,
+                    L"Clawbrowser has been installed successfully.");
+  } else {
+    ::SetWindowText(state->status_text,
+                    L"Clawbrowser could not be installed. Close this window "
+                    L"and run setup again.");
+  }
+  ::SetWindowText(state->install_button, L"Close");
+  ::EnableWindow(state->install_button, TRUE);
+  ::ShowWindow(state->cancel_button, SW_HIDE);
+}
+
+LRESULT CALLBACK ClawbrowserSetupWindowProc(HWND window,
+                                            UINT message,
+                                            WPARAM wparam,
+                                            LPARAM lparam) {
+  ClawbrowserSetupWizardState* state =
+      reinterpret_cast<ClawbrowserSetupWizardState*>(
+          ::GetWindowLongPtr(window, GWLP_USERDATA));
+
+  switch (message) {
+    case WM_NCCREATE: {
+      CREATESTRUCT* create = reinterpret_cast<CREATESTRUCT*>(lparam);
+      ::SetWindowLongPtr(
+          window, GWLP_USERDATA,
+          reinterpret_cast<LONG_PTR>(create->lpCreateParams));
+      return TRUE;
+    }
+    case WM_CREATE: {
+      state = reinterpret_cast<ClawbrowserSetupWizardState*>(
+          reinterpret_cast<CREATESTRUCT*>(lparam)->lpCreateParams);
+      state->window = window;
+      HFONT font = static_cast<HFONT>(::GetStockObject(DEFAULT_GUI_FONT));
+      HWND icon = ::CreateWindowW(L"STATIC", nullptr,
+                                  WS_CHILD | WS_VISIBLE | SS_ICON, 24, 24,
+                                  kClawbrowserSetupIconSize,
+                                  kClawbrowserSetupIconSize, window, nullptr,
+                                  nullptr, nullptr);
+      HICON setup_icon = LoadClawbrowserSetupIcon(kClawbrowserSetupIconSize);
+      if (icon && setup_icon) {
+        ::SendMessage(icon, STM_SETICON, reinterpret_cast<WPARAM>(setup_icon),
+                      0);
+      }
+      HWND title = ::CreateWindowW(L"STATIC", L"Install Clawbrowser",
+                                   WS_CHILD | WS_VISIBLE, 92, 22, 360, 28,
+                                   window, nullptr, nullptr, nullptr);
+      HWND body = ::CreateWindowW(
+          L"STATIC",
+          L"Setup will install Clawbrowser for this Windows user.",
+          WS_CHILD | WS_VISIBLE, 92, 62, 360, 28, window, nullptr, nullptr,
+          nullptr);
+      state->status_text = ::CreateWindowW(
+          L"STATIC", L"Click Install to begin.", WS_CHILD | WS_VISIBLE, 92, 108,
+          360, 36, window, nullptr, nullptr, nullptr);
+      state->install_button = ::CreateWindowW(
+          L"BUTTON", L"&Install", WS_CHILD | WS_VISIBLE | BS_DEFPUSHBUTTON,
+          280, 168, 84, 30, window,
+          reinterpret_cast<HMENU>(kClawbrowserInstallButtonId), nullptr,
+          nullptr);
+      state->cancel_button = ::CreateWindowW(
+          L"BUTTON", L"Cancel", WS_CHILD | WS_VISIBLE, 374, 168, 84, 30,
+          window, reinterpret_cast<HMENU>(kClawbrowserCancelButtonId), nullptr,
+          nullptr);
+      SetControlFont(title, font);
+      SetControlFont(body, font);
+      SetControlFont(state->status_text, font);
+      SetControlFont(state->install_button, font);
+      SetControlFont(state->cancel_button, font);
+      return 0;
+    }
+    case WM_COMMAND:
+      if (LOWORD(wparam) == kClawbrowserInstallButtonId) {
+        if (!state->started) {
+          StartClawbrowserSetupInstall(state);
+        } else if (state->finished) {
+          ::DestroyWindow(window);
+        }
+        return 0;
+      }
+      if (LOWORD(wparam) == kClawbrowserCancelButtonId && !state->started) {
+        state->result = ProcessExitResult(GENERIC_ERROR);
+        ::DestroyWindow(window);
+        return 0;
+      }
+      break;
+    case kClawbrowserInstallCompleteMessage:
+      FinishClawbrowserSetupInstall(state);
+      return 0;
+    case WM_CLOSE:
+      if (!state->started || state->finished) {
+        ::DestroyWindow(window);
+      } else {
+        ::MessageBeep(MB_ICONINFORMATION);
+      }
+      return 0;
+    case WM_DESTROY:
+      ::PostQuitMessage(0);
+      return 0;
+  }
+
+  return ::DefWindowProc(window, message, wparam, lparam);
+}
+
+ProcessExitResult RunClawbrowserSetupWizard(const Configuration& configuration,
+                                            const wchar_t* archive_path,
+                                            const wchar_t* setup_path,
+                                            bool compressed_archive) {
+  HINSTANCE instance = ::GetModuleHandle(nullptr);
+  WNDCLASSW window_class = {};
+  window_class.lpfnWndProc = ClawbrowserSetupWindowProc;
+  window_class.hInstance = instance;
+  window_class.hbrBackground =
+      reinterpret_cast<HBRUSH>(static_cast<uintptr_t>(COLOR_WINDOW + 1));
+  window_class.hCursor = ::LoadCursor(nullptr, IDC_ARROW);
+  window_class.hIcon = LoadClawbrowserSetupIcon(::GetSystemMetrics(SM_CXICON));
+  if (!window_class.hIcon) {
+    window_class.hIcon = ::LoadIcon(nullptr, IDI_APPLICATION);
+  }
+  window_class.lpszClassName = kClawbrowserSetupWindowClass;
+  if (!::RegisterClassW(&window_class) &&
+      ::GetLastError() != ERROR_CLASS_ALREADY_EXISTS) {
+    return RunSetup(configuration, archive_path, setup_path, compressed_archive,
+                    true);
+  }
+
+  constexpr int kWidth = 500;
+  constexpr int kHeight = 255;
+  const int x = (::GetSystemMetrics(SM_CXSCREEN) - kWidth) / 2;
+  const int y = (::GetSystemMetrics(SM_CYSCREEN) - kHeight) / 2;
+
+  ClawbrowserSetupWizardState state(configuration, archive_path, setup_path,
+                                    compressed_archive);
+  HWND window = ::CreateWindowExW(
+      0, kClawbrowserSetupWindowClass, L"Clawbrowser Setup",
+      WS_OVERLAPPED | WS_CAPTION | WS_SYSMENU, x, y, kWidth, kHeight, nullptr,
+      nullptr, instance, &state);
+  if (!window) {
+    return RunSetup(configuration, archive_path, setup_path, compressed_archive,
+                    true);
+  }
+
+  HICON small_icon =
+      LoadClawbrowserSetupIcon(::GetSystemMetrics(SM_CXSMICON));
+  if (small_icon) {
+    ::SendMessage(window, WM_SETICON, ICON_SMALL,
+                  reinterpret_cast<LPARAM>(small_icon));
+  }
+
+  ::ShowWindow(window, SW_SHOWNORMAL);
+  ::UpdateWindow(window);
+
+  MSG message;
+  while (::GetMessage(&message, nullptr, 0, 0) > 0) {
+    ::TranslateMessage(&message);
+    ::DispatchMessage(&message);
+  }
+
+  return state.result;
+}
