+bool AppendSetupSwitchIfMissing(const Configuration& configuration,
+                                const wchar_t* switch_name,
+                                CommandString* cmd_line) {
+  if (configuration.HasSwitch(switch_name)) {
+    return true;
+  }
+  return cmd_line->append(L" --") && cmd_line->append(switch_name);
+}
