+bool SwitchArgumentMatches(const wchar_t* argument, const wchar_t* switch_name) {
+  if (!argument || !switch_name || !*switch_name) {
+    return false;
+  }
+
+  if (argument[0] == L'-' && argument[1] == L'-') {
+    argument += 2;
+  } else if (argument[0] == L'/') {
+    argument += 1;
+  } else {
+    return false;
+  }
+
+  const int switch_length = ::lstrlenW(switch_name);
+  if (::lstrlenW(argument) < switch_length) {
+    return false;
+  }
+  if (::CompareStringOrdinal(argument, switch_length, switch_name,
+                             switch_length, TRUE) != CSTR_EQUAL) {
+    return false;
+  }
+
+  return argument[switch_length] == L'\0' || argument[switch_length] == L'=';
+}
